# ═══════════════════════════════════════════════════════════════════════════
# .env da RAIZ — lido só pelo docker-compose.yml (Postgres + pgAdmin)
# ═══════════════════════════════════════════════════════════════════════════
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=seu_banco
PGADMIN_EMAIL=voce@jvo.adv.br
PGADMIN_PASSWORD=troque_por_uma_senha_forte

# ═══════════════════════════════════════════════════════════════════════════
# backend/.env — lido pelo Node (npm run dev / npm start)
# ═══════════════════════════════════════════════════════════════════════════
# O Postgres do compose publica na porta 5433 (não 5432). Usuário/senha/banco
# são os mesmos POSTGRES_* acima.
# DATABASE_URL="postgresql://seu_usuario:sua_senha@localhost:5433/seu_banco"
# PORT=3001
# LOG_LEVEL=info                 # debug | info | warn | error
# FRONTEND_URL=                  # origem permitida no CORS; vazio = localhost:5173/3000
# FIREBASE_PROJECT_ID=           # vazio = projeto padrão do frontend

# Robô do PJe (Painel do Advogado) — certificado A1 do advogado
# MNI_CERT_PATH=C:\caminho\certificado.pfx
# MNI_CERT_SENHA=
# PJE_TOTP_SECRET=               # segredo base32 do 2FA do SSO do PJe
# PJE_URL=                       # opcional; padrão TJMT 1º grau

# Desliga as buscas automáticas (útil em máquina de desenvolvimento)
# DISABLE_DJEN_CRON=true
# DISABLE_PJE_CRON=true
