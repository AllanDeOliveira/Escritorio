# ─── Banco de Dados (PostgreSQL via Docker) ────────────────────────────────────
DATABASE_URL="postgresql://seu_usuario:sua_senha@localhost:5432/seu_banco"

# ─── Redis (BullMQ via Docker) ─────────────────────────────────────────────────
REDIS_URL="redis://seu_host_redis:6379"

# ─── Google Gemini API ─────────────────────────────────────────────────────────
GEMINI_API_KEY="sua_chave_google_ai_studio_aqui"

# ─── Autenticação JWT ──────────────────────────────────────────────────────────
JWT_SECRET="troque_por_uma_string_secreta_longa"

# ─── Datajud CNJ API (Chave Pública) ──────────────────────────────────────────
DATAJUD_API_KEY="sua_chave_publica_datajud_aqui"

# ─── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
