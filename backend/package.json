{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker/worker.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" index.js",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/worker.ts",
    "build": "npx prisma generate && npx prisma db push --accept-data-loss && tsc",
    "db:push": "prisma db push --accept-data-loss",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^1.48.0",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.76.1",
    "cors": "^2.8.6",
    "docxtemplater": "^3.68.3",
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pizzip": "^3.2.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.6",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  }
}
