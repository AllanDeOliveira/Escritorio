generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String            @id @default(uuid())
  email          String            @unique
  name           String?
  role           String            @default("member") // admin | member
  areas          String[]          @default([]) // áreas que a pessoa tria (chaves de AREAS no PrazosTab.tsx)
  noQuadro       Boolean           @default(false) // tem coluna no quadro de prazos "Por pessoa" (admin define)
  createdAt      DateTime          @default(now())
  prazos         Prazo[]

  @@map("usuarios")
}

model SystemSettings {
  id                String   @id @default(uuid())

  // Heartbeat da sincronização DJEN. djenLastSyncAt só avança numa passada LIMPA
  // (erros.length === 0): a API do DJEN falha sem lançar, então "completou" não é
  // "buscou". Carimbar um sync sujo esconderia dias sem intimação atrás de um "✓".
  djenLastSyncAt    DateTime? // última busca limpa — base da regra de staleness
  djenLastAttemptAt DateTime? // início da última execução (sempre)
  djenLastError     String? // erros da última execução; null quando limpa
  djenLastCriadas   Int      @default(0)

  // Última leitura do Painel do PJe (cron ou botão): tribunais que falharam.
  // Sem isso, falha no cron só ia para o log e o quadro parecia normal.
  pjeLastAttemptAt  DateTime?
  pjeLastFalhas     Json? // [{ tribunal, erro }]; [] quando todos leram

  updatedAt         DateTime @updatedAt

  @@map("configuracoes_sistema")
}

model Prazo {
  id          String  @id @default(uuid())
  title       String
  description String?
  type        String  @default("JUDICIAL") // JUDICIAL | ADMINISTRATIVO | INTERNO
  status      String  @default("PENDENTE") // PENDENTE | CUMPRIDO | CANCELADO
  prioridade  String? // ALTA | MEDIA | BAIXA (null = sem prioridade definida)
  source      String? // 'PLANILHA' quando veio de importação; null = criado manualmente

  fatalDate    DateTime // prazo fatal (limite intransponível)
  internalDate DateTime? // prazo interno (alvo da equipe)
  completedAt  DateTime?

  responsibleName String? // nome livre do responsável (não exige usuário cadastrado)
  caseReference   String? // processo / cliente em texto livre ("Silva vs Banco X")

  lastMovedBy   String?   // nome de quem moveu o card por último (auditoria)
  lastMovedAt   DateTime? // quando foi a última movimentação de status

  responsibleId String?
  responsible   User?    @relation(fields: [responsibleId], references: [id])

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  intimacoes Intimacao[]

  @@index([fatalDate])
  @@index([status])
  @@index([responsibleId])
  @@map("prazos")
}

model Intimacao {
  id     String @id @default(uuid())
  djenId String @unique // id da comunicação na API Comunica/DJEN — evita duplicar

  numeroProcesso       String?
  tribunal             String?
  orgao                String?
  tipoComunicacao      String?
  tipoDocumento        String?
  nomeClasse           String?
  texto                String?
  link                 String? // link do tribunal (nem sempre resolve na consulta pública)
  hash                 String? // hash DJEN — gera a certidão oficial em PDF, link confiável
  meio                 String?
  dataDisponibilizacao DateTime?
  clienteExtraido      String? // melhor esforço: nome da parte extraído do teor
  advogadoNome         String?
  oabConsulta          String? // qual OAB monitorada trouxe esta comunicação

  status      String    @default("NOVA") // NOVA | GERADA | DESCARTADA
  revisadoPor String?
  revisadoEm  DateTime?

  prazoId String?
  prazo   Prazo?  @relation(fields: [prazoId], references: [id])

  createdAt DateTime @default(now())

  @@index([status])
  @@index([dataDisponibilizacao])
  @@map("intimacoes")
}

// Expediente lido do Painel do Advogado do PJe (robô com certificado A1).
// O prazo e a data limite são os que o PRÓPRIO PJe calcula — fonte da verdade.
// Só leitura: o robô nunca clica em "Tomar ciência" nem abre o documento.
model ExpedientePje {
  id           String @id @default(uuid())
  tribunal     String // TJMT | TRF1 ...
  idExpediente String // número do expediente no PJe

  numeroProcesso String? // só dígitos (20), para casar com Intimacao
  tipo           String? // Intimação, Decisão, Citação...
  destinatario   String?
  meio           String? // Diário Eletrônico, Sistema...
  orgao          String?
  partes         String?
  dataExpedicao  DateTime?

  prazoDias       Int? // null = "sem prazo"
  cienciaPendente Boolean   @default(false) // ainda não houve ciência
  dataCiencia     DateTime?
  dataLimite      DateTime? // "Data limite prevista para manifestação" (23:59)

  // Onde estava no painel: aba › jurisdição › caixa (mostrado no card)
  situacao   String? // "Apenas pendentes de resposta", "Cujo prazo findou…"
  jurisdicao String? // "CUIABÁ CÍVEL", "CÁCERES JUIZADOS"...
  caixa      String? // "Caixa de entrada" ou a caixa nomeada do escritório

  vistoEm DateTime @default(now()) // última leitura em que o expediente apareceu no painel

  // Prazo criado automaticamente no quadro. Sem FK de propósito: se alguém excluir
  // o prazo, o id continua aqui e o robô NÃO recria (a exclusão foi decisão humana).
  prazoId String?

  @@unique([tribunal, idExpediente])
  @@index([numeroProcesso])
  @@map("expedientes_pje")
}
