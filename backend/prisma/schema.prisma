generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("organizacoes")
}

model User {
  id             String            @id @default(uuid())
  email          String            @unique
  name           String?
  role           String            @default("member") // admin | member
  organizationId String?
  createdAt      DateTime          @default(now())
  documents      DocumentHistory[]
  models         KnowledgeModel[]
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  prazos         Prazo[]

  @@map("usuarios")
}

model DataSource {
  id        String       @id @default(uuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  processes Process[]
  payloads  RawPayload[]

  @@map("fontes_dados")
}

model Court {
  id            String        @id @default(uuid())
  acronym       String        @unique
  name          String
  judgingBodies JudgingBody[]
  processes     Process[]

  @@map("tribunais")
}

model JudgingBody {
  id        String    @id @default(uuid())
  name      String
  courtId   String
  court     Court     @relation(fields: [courtId], references: [id])
  processes Process[]

  @@map("orgaos_julgadores")
}

model Process {
  id            String            @id @default(uuid())
  cnjNumber     String            @unique
  filingDate    DateTime?
  classId       String?
  className     String?
  subjectCode   String? // código do assunto TPU (assuntos[0].codigo do DataJud) — matéria jurídica real
  subjectName   String? // nome do assunto TPU (assuntos[0].nome) — usado para agrupar teses
  dataSourceId  String
  courtId       String?
  judgingBodyId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  movements     Movement[]
  judgingBody   JudgingBody?      @relation(fields: [judgingBodyId], references: [id])
  court         Court?            @relation(fields: [courtId], references: [id])
  dataSource    DataSource        @relation(fields: [dataSourceId], references: [id])
  snapshots     ProcessSnapshot[]
  payloads      RawPayload[]

  @@map("processos_judiciais")
}

model Movement {
  id          String   @id @default(uuid())
  processId   String
  date        DateTime
  code        String?
  description String
  createdAt   DateTime @default(now())
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@map("movimentacoes")
}

model ProcessSnapshot {
  id         String   @id @default(uuid())
  processId  String
  status     String
  capturedAt DateTime @default(now())
  process    Process  @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@map("snapshots_processo")
}

model RawPayload {
  id           String     @id @default(uuid())
  processId    String
  dataSourceId String
  payload      String
  capturedAt   DateTime   @default(now())
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id])
  process      Process    @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@map("payloads_brutos")
}

model LegalThesis {
  id          String      @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  precedents  Precedent[]

  @@map("teses_juridicas")
}

model Precedent {
  id        String      @id @default(uuid())
  thesisId  String
  cnjNumber String
  summary   String?
  thesis    LegalThesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  @@map("precedentes")
}

model DocumentHistory {
  id          String   @id @default(uuid())
  title       String?
  clientName  String?
  caseNumber  String?
  content     String
  timeline    String?
  auditData   String?
  analytics   String?
  fontesWeb   String?
  matrizDuelo String?
  userId      String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
  isFavorite  Boolean  @default(false)

  @@map("historico_documentos")
}

model MonitoringArea {
  id            String            @id @default(uuid())
  name          String
  courtAcronym  String
  subjectCode   String?
  filters       Json?
  active        Boolean           @default(true)
  lastScannedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  analyses      AreaAnalysis[]
  outcomes      OutcomeAnalysis[]

  @@map("areas_monitoramento")
}

model AreaAnalysis {
  id               String         @id @default(uuid())
  monitoringAreaId String
  analysis         String
  createdAt        DateTime       @default(now())
  monitoringArea   MonitoringArea @relation(fields: [monitoringAreaId], references: [id], onDelete: Cascade)

  @@map("analises_area")
}

model OutcomeAnalysis {
  id               String         @id @default(uuid())
  monitoringAreaId String
  teseName         String
  results          String
  statistics       String
  createdAt        DateTime       @default(now())
  monitoringArea   MonitoringArea @relation(fields: [monitoringAreaId], references: [id], onDelete: Cascade)

  @@map("analises_resultado")
}

model SystemSettings {
  id                String   @id @default(uuid())
  whatsappGroupId   String?
  whatsappGroupName String?

  // Heartbeat da sincronização DJEN. djenLastSyncAt só avança numa passada LIMPA
  // (erros.length === 0): a API do DJEN falha sem lançar, então "completou" não é
  // "buscou". Carimbar um sync sujo esconderia dias sem intimação atrás de um "✓".
  djenLastSyncAt    DateTime? // última busca limpa — base da regra de staleness
  djenLastAttemptAt DateTime? // início da última execução (sempre)
  djenLastError     String? // erros da última execução; null quando limpa
  djenLastCriadas   Int      @default(0)

  updatedAt         DateTime @updatedAt

  @@map("configuracoes_sistema")
}

model Client {
  id        String    @id @default(uuid())
  name      String
  cpf_cnpj  String    @unique
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Lawsuits  Lawsuit[]
  prazos    Prazo[]

  @@map("clientes")
}

model Lawsuit {
  id            String     @id @default(uuid())
  caseNumber    String     @unique
  court         String?
  actionType    String?
  opposingParty String?
  status        String     @default("ATIVO")
  notes         String?
  clientId      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  client        Client?    @relation(fields: [clientId], references: [id])
  Petitions     Petition[]
  prazos        Prazo[]

  @@map("acoes_judiciais")
}

model Petition {
  id        String   @id @default(uuid())
  title     String
  content   String
  status    String   @default("RASCUNHO")
  lawsuitId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lawsuit   Lawsuit  @relation(fields: [lawsuitId], references: [id])

  @@map("peticoes")
}

model Event {
  id        String   @id @default(uuid())
  title     String
  type      String
  urgency   String
  date      String
  time      String?
  notes     String?
  lawsuitId String?
  clientId  String?
  createdAt DateTime @default(now())

  @@map("eventos")
}

model Prazo {
  id          String  @id @default(uuid())
  title       String
  description String?
  type        String  @default("JUDICIAL") // JUDICIAL | ADMINISTRATIVO | INTERNO
  status      String  @default("PENDENTE") // PENDENTE | CUMPRIDO | CANCELADO
  source      String? // 'PLANILHA' quando veio de importação; null = criado manualmente

  fatalDate    DateTime // prazo fatal (limite intransponível)
  internalDate DateTime? // prazo interno (alvo da equipe)
  completedAt  DateTime?

  responsibleName String? // nome livre do responsável (não exige usuário cadastrado)
  caseReference   String? // processo / cliente em texto livre ("Silva vs Banco X")

  lastMovedBy   String?   // nome de quem moveu o card por último (auditoria)
  lastMovedAt   DateTime? // quando foi a última movimentação de status

  responsibleId String?
  responsible   User?    @relation(fields: [responsibleId], references: [id])
  lawsuitId     String?
  lawsuit       Lawsuit? @relation(fields: [lawsuitId], references: [id])
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  intimacoes Intimacao[]

  @@index([fatalDate])
  @@index([status])
  @@index([responsibleId])
  @@map("prazos")
}

model Intimacao {
  id     String @id @default(uuid())
  djenId String @unique // id da comunicação na API Comunica/DJEN — evita duplicar

  numeroProcesso       String?
  tribunal             String?
  orgao                String?
  tipoComunicacao      String?
  tipoDocumento        String?
  nomeClasse           String?
  texto                String?
  link                 String? // link do tribunal (nem sempre resolve na consulta pública)
  hash                 String? // hash DJEN — gera a certidão oficial em PDF, link confiável
  meio                 String?
  dataDisponibilizacao DateTime?
  clienteExtraido      String? // melhor esforço: nome da parte extraído do teor
  advogadoNome         String?
  oabConsulta          String? // qual OAB monitorada trouxe esta comunicação

  status      String    @default("NOVA") // NOVA | GERADA | DESCARTADA
  revisadoPor String?
  revisadoEm  DateTime?

  prazoId String?
  prazo   Prazo?  @relation(fields: [prazoId], references: [id])

  createdAt DateTime @default(now())

  @@index([status])
  @@index([dataDisponibilizacao])
  @@map("intimacoes")
}

model KnowledgeModel {
  id        String   @id @default(uuid())
  nome      String   @unique
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("modelos_conhecimento")
}
